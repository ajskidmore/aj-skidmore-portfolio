# Frontend (.env / .env.production): only public settings belong here.
# Anything named REACT_APP_* is copied into the public JavaScript bundle,
# so NEVER put an API key in a REACT_APP_* variable.
REACT_APP_CHAT_API_URL=
REACT_APP_CLEAR_CHAT_API_URL=

# Server-side only (functions/.env for Firebase Functions, or .env for the
# local proxy-server.js):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
